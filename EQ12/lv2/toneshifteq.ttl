idpy:queue_draw a lv2:Feature .
idpy:interface a lv2:ExtensionData .

<urn:name#me>
   a foaf:Person ;
   foaf:name "brummer" .

<urn:brummer:toneshifteq>
    a lv2:Plugin ,
       lv2:EQPlugin ;
    doap:name "ToneShift-EQ12" ;
    doap:maintainer <urn:name#me> ;
    lv2:requiredFeature urid:map ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:optionalFeature idpy:queue_draw ;
    lv2:optionalFeature <http://lv2plug.in/ns/ext/instance-access>;
    lv2:extensionData idpy:interface ;
    lv2:minorVersion 7 ;
    lv2:microVersion 1 ;

rdfs:comment """
ToneShiftEQ is a modern 12-band parametric equalizer featuring both a minimum-phase FFT convolution engine and a zero-latency biquad engine. 
""";

guiext:ui <urn:brummer:toneshifteq_ui> ;

    lv2:port
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 0 ;
